// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id           String                @id @default(cuid())
  nombre       String                @unique
  direccion    String?
  esPrincipal  Boolean               @default(false)
  activo       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  dailyBalances        DailyBalance[]
  purchaseTransactions PurchaseTransaction[]
  saleTransactions     SaleTransaction[]
  purchases            Purchase[]
  sales                Sale[]
  expenses             Expense[]
  productoCargas       ProductoCarga[]
}

model Producto {
  id                  String          @id @default(cuid())
  nombre              String          @unique
  precioPorLibra      Decimal         @db.Decimal(10, 2)
  taraPorSaco         Decimal?        @db.Decimal(6, 2)
  factorConversionOro Decimal?        @db.Decimal(6, 4)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  purchases           Purchase[]
  sales               Sale[]
  cargas              ProductoCarga[]
}

model ProductoCarga {
  id              String   @id @default(cuid())
  businessDate    DateTime @db.Date
  sucursalId      String
  productoId      String
  productoNombre  String
  libras          Decimal? @db.Decimal(10, 2)
  descripcion     String?
  createdAt       DateTime @default(now())
  producto        Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal        Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([productoId])
  @@index([sucursalId])
}

model Client {
  id              String                @id @default(cuid())
  nombre          String                @unique
  nombres         String?
  apellidos       String?
  claveIhcafe     String?
  telefono        String?
  direccion       String?
  rtn             String?
  cuentaBancaria  String?
  notas           String?
  esGeneral       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseTransactions PurchaseTransaction[]
  saleTransactions     SaleTransaction[]
  clientesOriginales   ClienteOriginal[]
}

model ClienteOriginal {
  id          String   @id @default(cuid())
  clientId    String
  nombres     String
  apellidos   String
  claveIhcafe String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model PurchaseTransaction {
  id           String     @id @default(cuid())
  businessDate DateTime   @db.Date
  sucursalId   String
  clientId     String
  total        Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sucursal     Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  items        Purchase[]

  @@index([businessDate])
  @@index([clientId])
  @@index([sucursalId])
}

model DailyBalance {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  saldoInicial Decimal  @db.Decimal(12, 2)
  saldoActual  Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@unique([businessDate, sucursalId])
}

model Purchase {
  id                   String              @id @default(cuid())
  businessDate         DateTime            @db.Date
  sucursalId           String
  productoId           String
  productoNombre       String
  precioPorLibra       Decimal             @db.Decimal(10, 2)
  pesoBruto            Decimal?            @db.Decimal(10, 2)
  numeroSacos          Int?
  taraPorSaco          Decimal?            @db.Decimal(6, 2)
  quintalesOro         Decimal?            @db.Decimal(10, 2)
  libras               Decimal             @db.Decimal(10, 2)
  total                Decimal             @db.Decimal(12, 2)
  purchaseTransactionId String?
  createdAt            DateTime            @default(now())
  producto             Producto            @relation(fields: [productoId], references: [id], onDelete: Restrict)
  purchaseTransaction  PurchaseTransaction? @relation(fields: [purchaseTransactionId], references: [id], onDelete: Cascade)
  sucursal             Sucursal            @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([purchaseTransactionId])
  @@index([sucursalId])
}

model Sale {
  id                String           @id @default(cuid())
  businessDate      DateTime         @db.Date
  sucursalId        String
  productoId        String?
  productoNombre    String?
  precioPorLibra    Decimal?         @db.Decimal(10, 2)
  libras            Decimal?         @db.Decimal(10, 2)
  descripcion       String?
  monto             Decimal          @db.Decimal(12, 2)
  saleTransactionId String?
  createdAt         DateTime         @default(now())
  producto          Producto?        @relation(fields: [productoId], references: [id], onDelete: Restrict)
  saleTransaction   SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)
  sucursal          Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([productoId])
  @@index([saleTransactionId])
  @@index([sucursalId])
}

model SaleTransaction {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  clientId     String
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  items        Sale[]

  @@index([businessDate])
  @@index([clientId])
  @@index([sucursalId])
}

model Expense {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  categoria    String
  descripcion  String
  monto        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([sucursalId])
}

model Employee {
  id           String            @id @default(cuid())
  nombre       String
  puesto       String?
  telefono     String?
  salario      Decimal?          @db.Decimal(12, 2)
  fechaIngreso DateTime?         @db.Date
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  payments     EmployeePayment[]
  attendance   Attendance[]
  advances     EmployeeAdvance[]
}

model EmployeePayment {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  concepto       String
  monto          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([employeeId])
}

model Attendance {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  horaEntrada    String?
  horaSalida     String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([businessDate, employeeId])
  @@index([businessDate])
  @@index([employeeId])
}

model EmployeeAdvance {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  monto          Decimal  @db.Decimal(12, 2)
  motivo         String?
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([employeeId])
}

model ModuleAccess {
  id        String   @id @default(cuid())
  moduleKey String   @unique
  roles     String[]
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id          String   @id @default("singleton")
  nombre      String   @default("")
  rtn         String   @default("")
  telefono    String   @default("")
  direccion   String   @default("")
  email       String   @default("")
  printerIp   String   @default("")
  printerPort Int      @default(9100)
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  nombre    String   @default("")
  password  String
  role      String   @default("viewer")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintJob {
  id          String   @id @default(cuid())
  status      String   @default("pending") // pending | claimed | done | error
  printerIp   String
  printerPort Int
  payloadB64  String
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model SyncEvent {
  id        String   @id @default(cuid())
  source    String
  entity    String
  entityId  String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
