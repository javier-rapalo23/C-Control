// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id                   String                @id @default(cuid())
  nombre               String                @unique
  direccion            String?
  esPrincipal          Boolean               @default(false)
  activo               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  dailyBalances        DailyBalance[]
  purchaseTransactions PurchaseTransaction[]
  saleTransactions     SaleTransaction[]
  purchases            Purchase[]
  sales                Sale[]
  expenses             Expense[]
  productoCargas       ProductoCarga[]
  cashSessions         CashSession[]
  cashEntries          CashEntry[]
  cashWithdrawals      CashWithdrawal[]
  cashTransfersOut     CashTransfer[]        @relation("CashTransferOrigen")
  cashTransfersIn      CashTransfer[]        @relation("CashTransferDestino")
  grindingServices     GrindingService[]
  employees            Employee[]
}

/// Un tipo de café del catálogo cerrado de `lib/coffee-types.ts`.
///
/// No lleva precio: el café se paga a un precio distinto por cliente y por día,
/// así que tenerlo aquí solo garantizaba que estuviera desactualizado. El precio
/// se captura a mano en cada línea de compra o venta.
///
/// Tampoco lleva factor de conversión a oro: el rendimiento varía por lote y por
/// productor, y ahora se captura por línea (`porcentajeOro`). Ver `lib/oro.ts`.
model Producto {
  id          String          @id @default(cuid())
  nombre      String          @unique
  /// `uva`, `pergamino` u `otros`. Agrupa el reporte de temporada y habilita el modo
  /// oro; **no** decide qué se factura: se factura todo lo que se compra y se vende.
  categoria   String?
  taraPorSaco Decimal?        @db.Decimal(6, 2)
  /// Clasificación para el ISV del documento fiscal, del catálogo de `lib/fiscal.ts`.
  /// El café está exonerado, así que por defecto es `EXENTO`; es configurable por si
  /// algún día se vende algo que no sea café.
  clasificacionFiscal String  @default("EXENTO")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchases   Purchase[]
  sales       Sale[]
  cargas      ProductoCarga[]
}

model ProductoCarga {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  sucursalId     String
  productoId     String
  productoNombre String
  libras         Decimal? @db.Decimal(10, 2)
  descripcion    String?
  createdAt      DateTime @default(now())
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal       Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([productoId])
  @@index([sucursalId])
}

model Client {
  id                   String                @id @default(cuid())
  nombre               String                @unique
  nombres              String?
  apellidos            String?
  claveIhcafe          String?
  nombreFinca          String?
  telefono             String?
  direccion            String?
  rtn                  String?
  cuentaBancaria       String?
  notas                String?
  esGeneral            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  purchaseTransactions PurchaseTransaction[]
  saleTransactions     SaleTransaction[]
  grindingServices     GrindingService[]
  clientesOriginales   ClienteOriginal[]
}

model ClienteOriginal {
  id          String   @id @default(cuid())
  clientId    String
  nombres     String
  apellidos   String
  claveIhcafe String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model PurchaseTransaction {
  id           String     @id @default(cuid())
  businessDate DateTime   @db.Date
  sucursalId   String
  clientId     String
  /// Valor del catálogo de `lib/payment-methods.ts`. Solo "efectivo" resta del
  /// saldo de caja: un depósito o un cheque no sacan dinero de la gaveta, aunque
  /// la compra sí exista para inventario y reportes.
  metodoPago   String     @default("efectivo")
  /// Número del talonario físico, capturado a mano. Va en la cabecera y no en la
  /// línea: una factura ampara la compra completa a un productor, y por línea dos
  /// renglones de la misma compra podrían declarar facturas distintas.
  numeroFactura String?
  /// Correlativo interno del comprobante, distinto de `numeroFactura` (que es el
  /// talonario físico y puede venir vacío). Lo asigna la base con una secuencia, no
  /// la aplicación: dos compras guardadas a la vez no pueden recibir el mismo
  /// número. Se imprime como `C-000123` en las dos copias de la factura.
  numeroInterno Int       @unique @default(autoincrement())
  /// Ajustes al pie de la factura. `bono` suma (premio por calidad, precio
  /// convenido) y `descuento` resta (pago a cortadores, adelantos ya entregados).
  /// El motivo se imprime al lado del monto: un descuento sin explicación es lo que
  /// el productor reclama.
  bono             Decimal @default(0) @db.Decimal(12, 2)
  bonoMotivo       String?
  descuento        Decimal @default(0) @db.Decimal(12, 2)
  descuentoMotivo  String?
  /// **Lo que se le paga al productor**: suma de las líneas + bono − descuento.
  /// Es lo que sale de la caja; el costo del café en sí es la suma de `items`.
  total        Decimal    @db.Decimal(12, 2)
  /// Liquidación de una compra con `metodoPago = "pendiente"`: la fecha de caja en
  /// que se pagó y con qué. Nulos mientras siga pendiente. Si se pagó en efectivo,
  /// resta del saldo de `pagoFecha`, no del día de la compra.
  pagoFecha         DateTime? @db.Date
  pagoMetodo        String?
  pagoRegistradoPor String?
  pagadoEn          DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sucursal     Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  items        Purchase[]
  /// Documento fiscal emitido por esta compra, si ya se emitió. Mientras exista, la
  /// compra no se puede borrar ni editar.
  fiscalDocument FiscalDocument?

  @@index([businessDate])
  @@index([clientId])
  @@index([sucursalId])
  @@index([pagoFecha])
}

/// Efectivo que entra a la caja sin ser una venta: reposición del dueño, retiro
/// del banco para tener cambio, devolución de un anticipo. Suma al saldo del día.
///
/// No se registra como una venta negativa ni como un gasto en negativo porque
/// ensuciaría los reportes de venta y de gasto con movimientos que no lo son.
/// Servicio de molido: se muele café del cliente y se le cobra por las libras.
///
/// El monto se escribe a mano, igual que las libras: no hay tarifa fija, así que
/// calcularlo obligaría a corregirlo en cada servicio. Es efectivo que entra a la
/// caja y suma al saldo del día; no toca inventario porque el café es del cliente.
model GrindingService {
  id            String   @id @default(cuid())
  businessDate  DateTime @db.Date
  sucursalId    String
  clientId      String
  libras        Decimal  @db.Decimal(10, 2)
  monto         Decimal  @db.Decimal(12, 2)
  notas         String?
  /// `userId` de quien lo registró, igual que en los ingresos de caja.
  registradoPor String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  fiscalDocument FiscalDocument?

  @@index([businessDate])
  @@index([sucursalId])
  @@index([clientId])
}

/// CAI autorizado por el SAR, con su rango y su vigencia.
///
/// Toda la empresa emite con un solo CAI por tipo de documento, así que los códigos
/// de establecimiento y punto de emisión son campos de aquí y no una tabla aparte.
/// El código del tipo de documento (`TT`) también se configura: cuál autorizó el SAR
/// lo dice el papel, no el programa.
///
/// El contador `ultimoCorrelativo` es lo que asigna los números, con un bloqueo de
/// fila: una secuencia de Postgres no sirve porque un rollback se come el número y
/// el rango del SAR no puede tener saltos.
model FiscalCai {
  id                    String   @id @default(cuid())
  /// Catálogo cerrado de `lib/fiscal.ts`: boleta_compra, factura, nota_credito…
  tipoDocumento         String
  /// El CAI impreso en la autorización.
  codigo                String   @unique
  codigoEstablecimiento String
  codigoPuntoEmision    String
  /// Código de dos dígitos del tipo de documento, tal como lo autorizó el SAR.
  codigoTipoDocumento   String
  /// Solo el correlativo: los otros tres segmentos del número salen de los códigos.
  rangoDesde            Int
  rangoHasta            Int
  fechaLimite           DateTime @db.Date
  /// TALONARIO: el número se captura a mano, como hoy. SISTEMA: lo asigna la app.
  modo                  String   @default("TALONARIO")
  /// `activo` | `inactivo`. Agotado y vencido no se guardan: se derivan del rango y
  /// de la fecha (`evaluarCai`), para que no puedan quedar desactualizados.
  estado                String   @default("activo")
  /// Último correlativo entregado. 0 en un CAI sin usar, aunque su rango no empiece en 1.
  ultimoCorrelativo     Int      @default(0)
  /// Umbrales de aviso: % de rango consumido y días antes de la fecha límite.
  alertaPorcentaje      Int      @default(80)
  alertaDiasPrevios     Int      @default(30)
  notas                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  documentos            FiscalDocument[]

  @@index([tipoDocumento, estado])
}

/// Documento fiscal emitido. Ampara **una** transacción: una compra, una venta o un
/// servicio de molido, nunca varias.
///
/// `snapshot` es la copia inmutable de lo impreso. Reimprimir usa el snapshot y no
/// los datos vivos: si mañana cambia el nombre de la empresa o del productor, el
/// documento ya emitido tiene que seguir diciendo lo que decía.
model FiscalDocument {
  id                     String   @id @default(cuid())
  caiId                  String
  tipoDocumento          String
  correlativo            Int
  /// `EEE-PPP-TT-CCCCCCCC`, ya formateado.
  numeroCompleto         String   @unique
  /// `emitido` | `anulado`. Un número nunca se libera: anular lo conserva.
  estado                 String   @default("emitido")
  /// Fecha de negocio de la transacción que ampara (puede ser anterior a la emisión).
  businessDate           DateTime @db.Date
  /// Cuándo se emitió de verdad. No es editable: de eso depende que la numeración
  /// salga en orden cronológico.
  emitidoEn              DateTime @default(now())
  emitidoPor             String
  /// Exactamente uno de los tres, y cada transacción a lo sumo una vez. El
  /// `Restrict` es lo que impide borrar en la base una transacción ya documentada,
  /// aunque una ruta olvide comprobarlo.
  purchaseTransactionId  String?  @unique
  saleTransactionId      String?  @unique
  grindingServiceId      String?  @unique
  total                  Decimal  @db.Decimal(12, 2)
  /// Previsto para una eventual factura de exportación; hoy siempre HNL.
  moneda                 String   @default("HNL")
  tipoCambio             Decimal? @db.Decimal(12, 6)
  importeExento          Decimal  @default(0) @db.Decimal(12, 2)
  importeExonerado       Decimal  @default(0) @db.Decimal(12, 2)
  importeGravado15       Decimal  @default(0) @db.Decimal(12, 2)
  importeGravado18       Decimal  @default(0) @db.Decimal(12, 2)
  isv15                  Decimal  @default(0) @db.Decimal(12, 2)
  isv18                  Decimal  @default(0) @db.Decimal(12, 2)
  snapshot               Json
  /// Versión de la maquetación con la que se emitió, para leer el snapshot viejo.
  formatoVersion         String
  anuladoEn              DateTime?
  anuladoPor             String?
  anulacionMotivo        String?
  /// Resguardo de la copia física del documento anulado.
  copiaFisicaResguardada Boolean  @default(false)
  copiaFisicaUbicacion   String?
  cai                    FiscalCai            @relation(fields: [caiId], references: [id], onDelete: Restrict)
  purchaseTransaction    PurchaseTransaction? @relation(fields: [purchaseTransactionId], references: [id], onDelete: Restrict)
  saleTransaction        SaleTransaction?     @relation(fields: [saleTransactionId], references: [id], onDelete: Restrict)
  grindingService        GrindingService?     @relation(fields: [grindingServiceId], references: [id], onDelete: Restrict)

  @@unique([caiId, correlativo])
  @@index([businessDate])
  @@index([estado])
  @@index([emitidoEn])
}

/// Bitácora de lo que no puede quedar sin rastro: emisión, anulación, reimpresión y
/// cambios de CAI. No se borra ni se edita.
model FiscalAuditLog {
  id               String   @id @default(cuid())
  /// emision | anulacion | reimpresion | cai_alta | cai_cambio
  accion           String
  fiscalDocumentId String?
  caiId            String?
  usuario          String
  detalle          Json?
  createdAt        DateTime @default(now())

  @@index([fiscalDocumentId])
  @@index([caiId])
  @@index([createdAt])
}

model CashEntry {
  id            String   @id @default(cuid())
  businessDate  DateTime @db.Date
  sucursalId    String
  descripcion   String
  monto         Decimal  @db.Decimal(12, 2)
  /// `userId` de quien lo registró, igual que en la apertura y el cierre de caja.
  registradoPor String
  createdAt     DateTime @default(now())
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([sucursalId])
}

/// Efectivo que sale de la caja sin ser una compra ni un gasto: retiro del dueño,
/// depósito del sobrante al banco. Resta del saldo del día.
///
/// Es la contraparte de `CashEntry` y por la misma razón no es un `Expense`: el
/// dinero no se gastó, solo dejó la gaveta, y contarlo como gasto inflaría el
/// reporte de gastos.
model CashWithdrawal {
  id            String   @id @default(cuid())
  businessDate  DateTime @db.Date
  sucursalId    String
  descripcion   String
  monto         Decimal  @db.Decimal(12, 2)
  /// `userId` de quien lo registró, igual que en la apertura y el cierre de caja.
  registradoPor String
  createdAt     DateTime @default(now())
  sucursal      Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([sucursalId])
}

/// Efectivo que una bodega (sucursal) le manda a otra. Resta del saldo del origen
/// y suma al del destino en la misma fecha.
///
/// Es un registro único y no un `CashWithdrawal` más un `CashEntry` sueltos: así
/// las dos cajas se mueven en la misma operación, borrarlo no deja la mitad viva,
/// y se puede responder cuánto se le ha mandado a una bodega.
model CashTransfer {
  id                String   @id @default(cuid())
  businessDate      DateTime @db.Date
  sucursalOrigenId  String
  sucursalDestinoId String
  descripcion       String?
  monto             Decimal  @db.Decimal(12, 2)
  /// `userId` de quien lo registró, igual que en la apertura y el cierre de caja.
  registradoPor     String
  createdAt         DateTime @default(now())
  sucursalOrigen    Sucursal @relation("CashTransferOrigen", fields: [sucursalOrigenId], references: [id], onDelete: Restrict)
  sucursalDestino   Sucursal @relation("CashTransferDestino", fields: [sucursalDestinoId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([sucursalOrigenId])
  @@index([sucursalDestinoId])
}

model DailyBalance {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  saldoInicial Decimal  @db.Decimal(12, 2)
  saldoActual  Decimal  @db.Decimal(12, 2)
  /// Diferencia del arqueo de caja (contado menos esperado), 0 mientras no se cierre.
  /// Entra en la ecuación del saldo para que, tras el cierre, saldoActual sea el
  /// efectivo realmente contado y no el teórico.
  ajusteCaja   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@unique([businessDate, sucursalId])
}

model Purchase {
  id                    String               @id @default(cuid())
  businessDate          DateTime             @db.Date
  sucursalId            String
  productoId            String
  productoNombre        String
  precioPorLibra        Decimal              @db.Decimal(10, 2)
  pesoBruto             Decimal?             @db.Decimal(10, 2)
  numeroSacos           Int?
  taraPorSaco           Decimal?             @db.Decimal(6, 2)
  // Rendimiento del lote en porcentaje (54.0000), igual que en `Sale.porcentajeOro`.
  porcentajeOro         Decimal?             @db.Decimal(6, 4)
  quintalesOro          Decimal?             @db.Decimal(10, 2)
  libras                Decimal              @db.Decimal(10, 2)
  total                 Decimal              @db.Decimal(12, 2)
  purchaseTransactionId String
  createdAt             DateTime             @default(now())
  producto              Producto             @relation(fields: [productoId], references: [id], onDelete: Restrict)
  purchaseTransaction   PurchaseTransaction  @relation(fields: [purchaseTransactionId], references: [id], onDelete: Cascade)
  sucursal              Sucursal             @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([purchaseTransactionId])
  @@index([sucursalId])
}

model Sale {
  id                  String           @id @default(cuid())
  businessDate        DateTime         @db.Date
  sucursalId          String
  productoId          String?
  productoNombre      String?
  precioPorLibra      Decimal?         @db.Decimal(10, 2)
  pesoBruto           Decimal?         @db.Decimal(10, 2)
  numeroSacos         Int?
  taraPorSaco         Decimal?         @db.Decimal(6, 2)
  // Peso neto (pesoBruto − taraPorSaco × numeroSacos) cuando la venta se pesó.
  libras              Decimal?         @db.Decimal(10, 2)
  // porcentajeOro se guarda como porcentaje (53.0000), no como fracción -- distinto de Producto.factorConversionOro.
  porcentajeOro       Decimal?         @db.Decimal(6, 4)
  quintalesOro        Decimal?         @db.Decimal(10, 2)
  precioPorQuintalOro Decimal?         @db.Decimal(10, 2)
  descripcion         String?
  monto               Decimal          @db.Decimal(12, 2)
  saleTransactionId   String
  createdAt           DateTime         @default(now())
  producto            Producto?        @relation(fields: [productoId], references: [id], onDelete: Restrict)
  saleTransaction     SaleTransaction  @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)
  sucursal            Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@index([businessDate])
  @@index([productoId])
  @@index([saleTransactionId])
  @@index([sucursalId])
}

model SaleTransaction {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  clientId     String
  /// Correlativo interno del comprobante, en serie propia: se imprime `V-000123`
  /// para no confundirlo con el `C-000123` de una compra. Lo asigna la base.
  numeroInterno Int     @unique @default(autoincrement())
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  items        Sale[]
  fiscalDocument FiscalDocument?

  @@index([businessDate])
  @@index([clientId])
  @@index([sucursalId])
}

model Expense {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  sucursalId   String
  /// Valor del catálogo de `lib/expenses.ts`, no texto libre: de eso depende que
  /// el reporte pueda agrupar por categoría.
  categoria    String
  /// Solo para la categoría "Pago banco": habilita el desglose por banco. Nulo en
  /// las demás categorías.
  bancoId      String?
  descripcion  String
  monto        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  banco        Banco?   @relation(fields: [bancoId], references: [id], onDelete: Restrict)
  // Gasto generado automáticamente por un pago o adelanto de planilla. Lo posee
  // ese registro: se borra con él y no debe eliminarse desde el panel de gastos.
  employeePayment EmployeePayment?
  employeeAdvance EmployeeAdvance?

  @@index([businessDate])
  @@index([sucursalId])
  @@index([bancoId])
}

/// Bancos a los que la empresa hace pagos. Es un catálogo administrable desde
/// Mantenimiento porque el cliente quiere el gasto desglosado por banco, y con el
/// nombre escrito a mano cada pago caía en un grupo distinto.
model Banco {
  id        String    @id @default(cuid())
  nombre    String    @unique
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Employee {
  id           String            @id @default(cuid())
  /// Sucursal a la que pertenece. La planilla se calcula por sucursal, así que
  /// cada empleado debe tener la suya: sin esto, el pago de una sucursal incluía
  /// al personal de las demás y le cargaba el gasto.
  sucursalId   String
  nombre       String
  puesto       String?
  telefono     String?
  // Pago por día trabajado. El nombre lleva la unidad porque de ella depende
  // el cálculo de la planilla semanal.
  salarioDiario Decimal?         @db.Decimal(12, 2)
  fechaIngreso DateTime?         @db.Date
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sucursal     Sucursal          @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  payments     EmployeePayment[]
  attendance   Attendance[]
  advances     EmployeeAdvance[]

  @@index([sucursalId])
}

model EmployeePayment {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  concepto       String
  monto          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  // "manual" = capturado a mano; "planilla" = generado por el cálculo semanal.
  tipo               String    @default("manual")
  periodoInicio      DateTime? @db.Date
  periodoFin         DateTime? @db.Date
  diasTrabajados     Int?
  salarioDiario      Decimal?  @db.Decimal(12, 2)
  subtotal           Decimal?  @db.Decimal(12, 2)
  adelantosAplicados Decimal?  @db.Decimal(12, 2)
  sucursalId         String?
  expenseId          String?   @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expense        Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  advanceApplications PayrollAdvanceApplication[]

  @@index([businessDate])
  @@index([employeeId])
  @@index([employeeId, periodoInicio, periodoFin])
}

/// Cuánto de un adelanto descontó una planilla concreta.
///
/// Sin este detalle no se podría revertir un pago: un mismo adelanto puede haber
/// sido descontado parcialmente por varias planillas, y `montoAplicado` por sí
/// solo no dice cuánto aportó cada una. Borrar el pago devuelve exactamente su parte.
model PayrollAdvanceApplication {
  id        String   @id @default(cuid())
  paymentId String
  advanceId String
  monto     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  payment   EmployeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  advance   EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, advanceId])
  @@index([advanceId])
}

model Attendance {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  horaEntrada    String?
  horaSalida     String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([businessDate, employeeId])
  @@index([businessDate])
  @@index([employeeId])
}

model EmployeeAdvance {
  id             String   @id @default(cuid())
  businessDate   DateTime @db.Date
  employeeId     String
  employeeNombre String
  monto          Decimal  @db.Decimal(12, 2)
  motivo         String?
  createdAt      DateTime @default(now())
  // Cuánto del adelanto ya se descontó en planillas. Permite aplicarlo en varias
  // semanas cuando excede el pago de una sola, sin descontarlo dos veces.
  montoAplicado    Decimal  @default(0) @db.Decimal(12, 2)
  sucursalId       String?
  expenseId        String?  @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expense        Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  applications   PayrollAdvanceApplication[]

  @@index([businessDate])
  @@index([employeeId])
}

/// Arqueo de caja por fecha y sucursal. Una sesión "cerrada" bloquea la escritura
/// de compras, ventas y gastos en esa fecha; solo un admin puede reabrirla.
/// La ausencia de sesión NO bloquea: abrir caja es opcional.
model CashSession {
  id            String    @id @default(cuid())
  businessDate  DateTime  @db.Date
  sucursalId    String
  estado        String    @default("abierta")
  montoApertura Decimal   @db.Decimal(12, 2)
  abiertaPor    String
  abiertaAt     DateTime  @default(now())
  /// Efectivo realmente contado al cerrar.
  montoContado  Decimal?  @db.Decimal(12, 2)
  /// Saldo que el sistema esperaba en el momento del cierre.
  saldoEsperado Decimal?  @db.Decimal(12, 2)
  /// montoContado − saldoEsperado. Negativo = falta efectivo.
  diferencia    Decimal?  @db.Decimal(12, 2)
  cerradaPor    String?
  cerradaAt     DateTime?
  notas         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sucursal      Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@unique([businessDate, sucursalId])
  @@index([businessDate])
  @@index([sucursalId])
}

model ModuleAccess {
  id        String   @id @default(cuid())
  moduleKey String   @unique
  roles     String[]
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id          String   @id @default("singleton")
  nombre      String   @default("")
  rtn         String   @default("")
  telefono    String   @default("")
  direccion   String   @default("")
  email       String   @default("")
  printerIp   String   @default("")
  printerPort Int      @default(9100)
  /// Datos de factura autorizada (SAR). Vacíos mientras el negocio facture con
  /// talonario físico: la factura A4 imprime el bloque fiscal solo cuando `cai`
  /// tiene valor, así que activarlo después es llenarlos y nada más.
  cai                String   @default("")
  facturaRangoDesde  String   @default("")
  facturaRangoHasta  String   @default("")
  facturaFechaLimite String   @default("")
  /// Formato con el que se imprime la factura por omisión: `a4` o `termico80`. Son
  /// dos formatos del **mismo** documento, no dos documentos distintos, así que esto
  /// es una preferencia de impresión y nada más. Ver `lib/print-formats.ts`.
  formatoImpresionDefault String @default("a4")
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  nombre    String   @default("")
  password  String
  role      String   @default("viewer")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintJob {
  id          String   @id @default(cuid())
  status      String   @default("pending") // pending | claimed | done | error
  printerIp   String
  printerPort Int
  payloadB64  String
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

